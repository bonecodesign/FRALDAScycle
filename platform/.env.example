NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4200
DATABASE_URL=postgresql://fraldacycle:change-me@127.0.0.1:5432/fraldacycle
DATABASE_SSL=false
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=2592000
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=http://127.0.0.1:4101,http://127.0.0.1:4102,http://127.0.0.1:4103
PILOT_BH_ENABLED=false
# Configure PILOT_BH_INVITED_EMAILS only in a private pilot environment; never commit real addresses.
# PILOT_BH_INVITED_EMAILS=participant@example.test,admin@example.test

NOTIFICATION_WEBHOOK_URL=https://notifications.example.com/v1/deliver
NOTIFICATION_WEBHOOK_SECRET=replace-with-provider-secret

MEDIA_PROVIDER_URL=https://media-provider.example.com/v1/signed-upload
MEDIA_PROVIDER_SECRET=replace-with-media-provider-secret
GEOCODING_PROVIDER_URL=https://geocoding-provider.example.com/v1/resolve
GEOCODING_PROVIDER_SECRET=replace-with-geocoding-provider-secret

PAYMENT_PROVIDER_URL=https://payments.example.com/v1
PAYMENT_PROVIDER_SECRET=replace-with-payment-provider-secret
PAYMENT_WEBHOOK_SECRET=replace-with-payment-webhook-secret
PAYMENT_PROVIDER_SDK_URL=https://payments.example.com/sdk.js
PAYMENT_PROVIDER_SDK_INTEGRITY=sha384-replace-with-provider-sri

LOGISTICS_PROVIDER_URL=https://logistics.example.com/v1
LOGISTICS_PROVIDER_SECRET=replace-with-logistics-provider-secret
LOGISTICS_WEBHOOK_SECRET=replace-with-logistics-webhook-secret

RATE_LIMIT_PROVIDER_URL=https://rate-limit.example.com/v1/check
RATE_LIMIT_PROVIDER_SECRET=replace-with-rate-limit-provider-secret
TELEMETRY_PROVIDER_URL=https://telemetry.example.com/v1/events
TELEMETRY_PROVIDER_SECRET=replace-with-telemetry-provider-secret

SECRETS_PROVIDER_URL=https://secrets.example.com/v1/resolve
SECRETS_PROVIDER_TOKEN=replace-with-secrets-provider-token
SECRETS_PROVIDER_KEYS=DATABASE_URL,SESSION_SECRET,NOTIFICATION_WEBHOOK_SECRET,MEDIA_PROVIDER_SECRET,GEOCODING_PROVIDER_SECRET,PAYMENT_PROVIDER_SECRET,PAYMENT_WEBHOOK_SECRET,LOGISTICS_PROVIDER_SECRET,LOGISTICS_WEBHOOK_SECRET,RATE_LIMIT_PROVIDER_SECRET,TELEMETRY_PROVIDER_SECRET
# Cadastro completo do responsável permanece desligado até os Termos deixarem de ser rascunho.
RESPONSIBLE_REGISTRATION_ENABLED=false
# Segredo exclusivo, com pelo menos 32 caracteres. Não reutilize SESSION_SECRET.
RESPONSIBLE_CPF_HMAC_SECRET=
ACCOUNT_CLOSURE_MAINTENANCE_ENABLED=false
ACCOUNT_CLOSURE_INTERVAL_MS=3600000
ASAAS_SANDBOX_ENABLED=false
ASAAS_SANDBOX_API_KEY=
ASAAS_WEBHOOK_ACCESS_TOKEN=
